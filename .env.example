# Chave do Google Gemini para OCR de cupons fiscais
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"

# Banco na nuvem (criado automaticamente ao conectar Upstash Redis na aba Storage da Vercel)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Segredo opcional para assinatura de sessões (se omitido, é derivado com segurança no servidor)
AUTH_SECRET=""

# Opcional: criar conta ADM automaticamente sem passar pela tela de Primeiro Acesso
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="uma-senha-forte-aqui"
